{
  "name": "kirsten-rossiter-blog",
  "private": true,
  "scripts": {
    "build": "node build-blog.js",
    "build:visual": "bash scripts/build-visual.sh",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "sync-tokens": "bash scripts/sync-tokens.sh && node scripts/lint-tokens.mjs",
    "test:site": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "15.0.12",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "kirsten-rossiter-tokens": "github:Boyzeeboy/kr-token-pipeline#v2.4.0"
  }
}
